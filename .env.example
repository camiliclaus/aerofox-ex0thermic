# Local inference uses the pinned llama.cpp service. No commercial credentials are used.
AEROFOX_LLM=auto
AEROFOX_MODEL=aerofox-qwen-1.5b
AEROFOX_LLM_URL=http://127.0.0.1:8793
AEROFOX_LLM_TIMEOUT=65
AEROFOX_LLM_QUEUE_WAIT=25
AEROFOX_TURN_DEADLINE=100
AEROFOX_LLM_DAILY_TURNS=500
AEROFOX_RATE_PER_MINUTE=12
AEROFOX_TRUST_PROXY=0
AEROFOX_CORS_ORIGINS=
